# Copy to .env and fill in what you have. Everything is optional:
# MIRAGE runs fully offline with its built-in text generator.

# Optional LLM providers used ONLY to pre-generate a cache of persona posts.
# Generated posts are cached under backend/.cache/llm/ and reused offline.
GROQ_API_KEY=
GEMINI_API_KEY=

# Simulation defaults
MIRAGE_REAL_ACCOUNTS=3000
MIRAGE_SEED=7
# simulated hours per real second
MIRAGE_SIM_RATE=1.0

# Ports
MIRAGE_API_PORT=8000
MIRAGE_WEB_PORT=3000
MIRAGE_CHAIN_PORT=8545

# Force the embedding backend: "auto" | "minilm" | "hashing"
MIRAGE_EMBEDDER=auto
